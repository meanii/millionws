# Two server ports, one loadgen, 100k connections: proves the 64k-per-pair
# ceiling is gone (a single port would stall at ~64k with "cannot assign
# requested address"). Usage: bench/local/run.sh nbio-2ports 100000 1
SERVER_REF=99d9237
SERVER_PATH=/ws
SERVER_ARGS="-port=8080 -ports=8081"
LOADGEN_URL="ws://server:8080/ws,ws://server:8081/ws"
